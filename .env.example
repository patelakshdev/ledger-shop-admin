# Copy this file to .env and fill in real values.
# For local development only — Vercel/Render env vars are set in the dashboard.

# PostgreSQL connection string (Render / Supabase / local)
# Local:  postgres://postgres:postgres@localhost:5432/ledger_shop
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger_shop

# JWT signing secret — generate a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS origin. "*" allows all (fine for the Vercel + Render setup).
CLIENT_ORIGIN=*

# Default super admin created by `npm run db:init` on first run
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_EMAIL=platform@ledger.app

NODE_ENV=development
PORT=3000
