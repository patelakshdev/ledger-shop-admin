{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static", "config": { "cleanUrls": false } }
  ],
  "routes": [
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
